<%- include('partials/header') %>

<div class="max-w-7xl mx-auto">
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-4xl font-bold text-gray-800 dark:text-gray-200 mb-2">
      Admin Panel
    </h1>
    <p class="text-gray-600 dark:text-gray-400">
      Manage users and monitor all shortened links
    </p>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-gradient-to-br from-blue-500 to-blue-600 dark:from-blue-700 dark:to-blue-800 rounded-2xl shadow-xl p-6 text-white">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-blue-100 text-sm uppercase tracking-wider mb-1">Total Users</p>
          <p class="text-4xl font-bold"><%= totalUsers %></p>
        </div>
        <div class="w-12 h-12 bg-white bg-opacity-20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-gradient-to-br from-purple-500 to-purple-600 dark:from-purple-700 dark:to-purple-800 rounded-2xl shadow-xl p-6 text-white">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-purple-100 text-sm uppercase tracking-wider mb-1">Total Links</p>
          <p class="text-4xl font-bold"><%= totalLinks %></p>
        </div>
        <div class="w-12 h-12 bg-white bg-opacity-20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-gradient-to-br from-green-500 to-green-600 dark:from-green-700 dark:to-green-800 rounded-2xl shadow-xl p-6 text-white">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-green-100 text-sm uppercase tracking-wider mb-1">Total Clicks</p>
          <p class="text-4xl font-bold"><%= totalClicks %></p>
        </div>
        <div class="w-12 h-12 bg-white bg-opacity-20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Users Section -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl dark:shadow-glow p-6 mb-8 border border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center">
        <div class="w-10 h-10 bg-gradient-to-r from-blue-400 to-purple-400 rounded-lg flex items-center justify-center mr-3 shadow-lg">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100">All Users</h2>
      </div>
      
      <!-- Search Input -->
      <div class="relative">
        <input 
          type="text" 
          id="userSearch" 
          placeholder="Search by email..." 
          class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400"
        />
        <svg class="absolute right-3 top-3 w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
        </svg>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-gray-200 dark:border-gray-700">
            <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Name</th>
            <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Email</th>
            <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Role</th>
            <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Status</th>
            <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Links</th>
            <th class="text-center py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Actions</th>
          </tr>
        </thead>
        <tbody id="userTableBody">
          <% users.forEach(user => { 
            const userLinks = allUrls.filter(url => url.user && url.user._id.toString() === user._id.toString());
            const userClicks = userLinks.reduce((sum, url) => sum + (url.clicks || 0), 0);
          %>
            <tr class="user-row border-b border-gray-100 dark:border-gray-700 hover:bg-blue-50 dark:hover:bg-gray-700 transition-colors cursor-pointer" 
                data-email="<%= user.email.toLowerCase() %>"
                onclick="window.location.href='/admin/user/<%= user._id %>'">
              <td class="py-4 px-4 text-gray-800 dark:text-gray-200"><%= user.name %></td>
              <td class="py-4 px-4 text-gray-600 dark:text-gray-400"><%= user.email %></td>
              <td class="py-4 px-4">
                <% if (user.isAdmin) { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200">
                    Admin
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200">
                    User
                  </span>
                <% } %>
              </td>
              <td class="py-4 px-4">
                <% if (user.isBlacklisted) { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"></path>
                    </svg>
                    Blacklisted
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    Active
                  </span>
                <% } %>
              </td>
              <td class="py-4 px-4 text-gray-600 dark:text-gray-400">
                <%= userLinks.length %> links (<%= userClicks %> clicks)
              </td>
              <td class="py-4 px-4 text-center">
                <% if (!user.isAdmin) { %>
                  <div class="flex items-center justify-center space-x-2">
                    <% if (user.isBlacklisted) { %>
                      <form action="/admin/unblacklist-user/<%= user._id %>" method="POST" class="inline" onsubmit="event.stopPropagation();">
                        <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-3 py-2 rounded-lg text-sm transition-all duration-200 hover:shadow-md">
                          Unblacklist
                        </button>
                      </form>
                    <% } else { %>
                      <form action="/admin/blacklist-user/<%= user._id %>" method="POST" class="inline" onsubmit="event.stopPropagation(); return handleBlacklistUser(event);">
                        <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-2 rounded-lg text-sm transition-all duration-200 hover:shadow-md">
                          Blacklist
                        </button>
                      </form>
                    <% } %>
                    <form action="/admin/delete-user/<%= user._id %>" method="POST" class="inline" onsubmit="event.stopPropagation(); return handleDeleteUser(event);">
                      <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded-lg text-sm transition-all duration-200 hover:shadow-md">
                        Delete
                      </button>
                    </form>
                  </div>
                <% } else { %>
                  <span class="text-gray-400 dark:text-gray-500 text-sm">Protected</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- All Links Section -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl dark:shadow-glow p-6 border border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center">
        <div class="w-10 h-10 bg-gradient-to-r from-purple-400 to-pink-400 rounded-lg flex items-center justify-center mr-3 shadow-lg">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100">All Links</h2>
      </div>
      
      <!-- Sort Dropdown -->
      <div class="flex items-center space-x-3">
        <label for="sortLinks" class="text-sm text-gray-600 dark:text-gray-400">Sort by:</label>
        <select 
          id="sortLinks" 
          class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"
        >
          <option value="date-desc">Date (Newest First)</option>
          <option value="date-asc">Date (Oldest First)</option>
          <option value="clicks-desc">Clicks (High to Low)</option>
          <option value="clicks-asc">Clicks (Low to High)</option>
        </select>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-gray-200 dark:border-gray-700">
            <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Owner</th>
            <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Short URL</th>
            <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Original URL</th>
            <th class="text-center py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Clicks</th>
            <th class="text-center py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Created</th>
            <th class="text-center py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Actions</th>
          </tr>
        </thead>
        <tbody id="linksTableBody">
          <% allUrls.forEach(url => { %>
            <tr class="link-row border-b border-gray-100 dark:border-gray-700 hover:bg-purple-50 dark:hover:bg-gray-700 transition-colors" 
                data-date="<%= new Date(url.createdAt).getTime() %>"
                data-clicks="<%= url.clicks || 0 %>">
              <td class="py-4 px-4 text-gray-800 dark:text-gray-200">
                <%= url.user ? url.user.name : 'Unknown' %>
                <div class="text-xs text-gray-500 dark:text-gray-500"><%= url.user ? url.user.email : '' %></div>
              </td>
              <td class="py-4 px-4">
                <code class="bg-gray-100 dark:bg-gray-700 text-accent dark:text-blue-400 px-2 py-1 rounded text-sm">
                  <%= url.shortUrl %>
                </code>
              </td>
              <td class="py-4 px-4">
                <div class="max-w-md truncate text-gray-600 dark:text-gray-400 text-sm" title="<%= url.fullUrl %>">
                  <%= url.fullUrl %>
                </div>
              </td>
              <td class="py-4 px-4 text-center">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200">
                  <%= url.clicks || 0 %>
                </span>
              </td>
              <td class="py-4 px-4 text-center text-gray-600 dark:text-gray-400 text-sm">
                <%= new Date(url.createdAt).toLocaleDateString() %>
              </td>
              <td class="py-4 px-4 text-center">
                <form action="/admin/delete-url/<%= url._id %>" method="POST" class="inline" onsubmit="return handleDeleteLink(event);">
                  <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-lg text-sm transition-all duration-200 hover:shadow-md">
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // User search functionality
  document.getElementById('userSearch').addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('.user-row');
    
    rows.forEach(row => {
      const email = row.getAttribute('data-email');
      if (email.includes(searchTerm)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  });

  // Links sorting functionality
  document.getElementById('sortLinks').addEventListener('change', function(e) {
    const sortBy = e.target.value;
    const tbody = document.getElementById('linksTableBody');
    const rows = Array.from(tbody.querySelectorAll('.link-row'));
    
    rows.sort((a, b) => {
      if (sortBy === 'date-desc') {
        return parseInt(b.getAttribute('data-date')) - parseInt(a.getAttribute('data-date'));
      } else if (sortBy === 'date-asc') {
        return parseInt(a.getAttribute('data-date')) - parseInt(b.getAttribute('data-date'));
      } else if (sortBy === 'clicks-desc') {
        return parseInt(b.getAttribute('data-clicks')) - parseInt(a.getAttribute('data-clicks'));
      } else if (sortBy === 'clicks-asc') {
        return parseInt(a.getAttribute('data-clicks')) - parseInt(b.getAttribute('data-clicks'));
      }
      return 0;
    });
    
    rows.forEach(row => tbody.appendChild(row));
  });

  // Custom confirmation handlers
  async function handleBlacklistUser(event) {
    event.preventDefault();
    const confirmed = await showConfirmModal(
      'Are you sure you want to blacklist this user? They will not be able to login.',
      'Blacklist User',
      'Blacklist',
      'orange'
    );
    if (confirmed) {
      event.target.submit();
    }
    return false;
  }

  async function handleDeleteUser(event) {
    event.preventDefault();
    const confirmed = await showConfirmModal(
      'Are you sure? This will permanently delete the user and all their links.',
      'Delete User',
      'Delete',
      'red'
    );
    if (confirmed) {
      event.target.submit();
    }
    return false;
  }

  async function handleDeleteLink(event) {
    event.preventDefault();
    const confirmed = await showConfirmModal(
      'Are you sure you want to delete this link?',
      'Delete Link',
      'Delete',
      'red'
    );
    if (confirmed) {
      event.target.submit();
    }
    return false;
  }
</script>

<%- include('partials/footer') %>
