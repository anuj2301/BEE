<%- include('partials/header') %>

<div class="max-w-6xl mx-auto">
  <!-- Back Button -->
  <div class="mb-6">
    <% if (user.isAdmin && !isOwnProfile) { %>
      <a href="/admin" class="inline-flex items-center text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
        </svg>
        Back to Admin Panel
      </a>
    <% } else { %>
      <a href="/dashboard" class="inline-flex items-center text-gray-600 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 transition-colors">
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
        </svg>
        Back to Dashboard
      </a>
    <% } %>
  </div>

  <!-- User Info Header -->
  <div class="bg-gradient-to-r from-blue-500 to-purple-600 dark:from-blue-700 dark:to-purple-800 rounded-2xl shadow-xl p-8 mb-8 text-white">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-bold mb-2"><%= viewUser.name %></h1>
        <p class="text-blue-100 text-lg"><%= viewUser.email %></p>
        <div class="mt-4 flex items-center space-x-3">
          <% if (viewUser.isAdmin) { %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-red-100 text-red-800">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"></path>
              </svg>
              Administrator
            </span>
          <% } else { %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-white bg-opacity-20 text-white">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
              </svg>
              Regular User
            </span>
          <% } %>
          
          <!-- Blacklist Status Badge -->
          <% if (viewUser.isBlacklisted) { %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-red-100 text-red-800">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"></path>
              </svg>
              Blacklisted
            </span>
          <% } else { %>
            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-green-100 text-green-800">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Active
            </span>
          <% } %>
        </div>
      </div>
      
      <!-- Admin Action Buttons -->
      <% if (canDelete && !viewUser.isAdmin) { %>
        <div class="flex items-center space-x-3">
          <% if (viewUser.isBlacklisted) { %>
            <form action="/admin/unblacklist-user/<%= viewUser._id %>" method="POST">
              <button type="submit" class="bg-green-500 hover:bg-green-600 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-200 hover:shadow-lg flex items-center space-x-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span>Unblacklist User</span>
              </button>
            </form>
          <% } else { %>
            <form action="/admin/blacklist-user/<%= viewUser._id %>" method="POST" onsubmit="return handleBlacklistUser(event, '<%= viewUser.name %>')">
              <button type="submit" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-200 hover:shadow-lg flex items-center space-x-2">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"></path>
                </svg>
                <span>Blacklist User</span>
              </button>
            </form>
          <% } %>
          
          <form action="/admin/delete-user/<%= viewUser._id %>" method="POST" onsubmit="return handleDeleteUser(event, '<%= viewUser.name %>', <%= totalLinks %>);">
            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-200 hover:shadow-lg flex items-center space-x-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              <span>Delete User</span>
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl dark:shadow-glow p-6 border border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 dark:text-gray-400 text-sm uppercase tracking-wider mb-1">Total Links Created</p>
          <p class="text-4xl font-bold text-gray-800 dark:text-gray-200"><%= totalLinks %></p>
        </div>
        <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-pink-500 dark:from-purple-600 dark:to-pink-600 rounded-xl flex items-center justify-center">
          <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"></path>
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl dark:shadow-glow p-6 border border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-600 dark:text-gray-400 text-sm uppercase tracking-wider mb-1">Total Clicks</p>
          <p class="text-4xl font-bold text-gray-800 dark:text-gray-200"><%= totalClicks %></p>
        </div>
        <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-teal-500 dark:from-green-600 dark:to-teal-600 rounded-xl flex items-center justify-center">
          <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- User's Links -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl dark:shadow-glow p-6 border border-gray-200 dark:border-gray-700">
    <div class="flex items-center mb-6">
      <div class="w-10 h-10 bg-gradient-to-r from-blue-400 to-purple-400 rounded-lg flex items-center justify-center mr-3 shadow-lg">
        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"></path>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100">All Links by <%= viewUser.name %></h2>
    </div>

    <% if (userUrls.length === 0) { %>
      <div class="text-center py-12">
        <svg class="w-16 h-16 mx-auto text-gray-400 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
        </svg>
        <p class="text-gray-600 dark:text-gray-400 text-lg">No links created yet</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700">
              <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Short URL</th>
              <th class="text-left py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Original URL</th>
              <th class="text-center py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Clicks</th>
              <th class="text-center py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Created</th>
              <th class="text-center py-3 px-4 text-gray-600 dark:text-gray-300 font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% userUrls.forEach(url => { %>
              <tr class="border-b border-gray-100 dark:border-gray-700 hover:bg-blue-50 dark:hover:bg-gray-700 transition-colors">
                <td class="py-4 px-4">
                  <code class="bg-gray-100 dark:bg-gray-700 text-accent dark:text-blue-400 px-3 py-1 rounded text-sm font-medium">
                    <%= url.shortUrl %>
                  </code>
                </td>
                <td class="py-4 px-4">
                  <div class="max-w-md truncate text-gray-600 dark:text-gray-400 text-sm" title="<%= url.fullUrl %>">
                    <%= url.fullUrl %>
                  </div>
                </td>
                <td class="py-4 px-4 text-center">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200">
                    <%= url.clicks || 0 %>
                  </span>
                </td>
                <td class="py-4 px-4 text-center text-gray-600 dark:text-gray-400 text-sm">
                  <%= new Date(url.createdAt).toLocaleDateString() %>
                  <div class="text-xs text-gray-500 dark:text-gray-500">
                    <%= new Date(url.createdAt).toLocaleTimeString() %>
                  </div>
                </td>
                <% if (canDelete) { %>
                  <td class="py-4 px-4 text-center">
                    <form action="/admin/delete-url/<%= url._id %>" method="POST" class="inline" onsubmit="return handleDeleteLink(event);">
                      <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-lg text-sm transition-all duration-200 hover:shadow-md">
                        Delete
                      </button>
                    </form>
                  </td>
                <% } else { %>
                  <td class="py-4 px-4 text-center">
                    <span class="text-gray-400 dark:text-gray-500 text-sm">-</span>
                  </td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
  // Custom confirmation handlers
  async function handleBlacklistUser(event, userName) {
    event.preventDefault();
    const confirmed = await showConfirmModal(
      `Are you sure you want to blacklist ${userName}? They will not be able to login.`,
      'Blacklist User',
      'Blacklist',
      'orange'
    );
    if (confirmed) {
      event.target.submit();
    }
    return false;
  }

  async function handleDeleteUser(event, userName, linkCount) {
    event.preventDefault();
    const confirmed = await showConfirmModal(
      `Are you sure? This will permanently delete ${userName} and all their ${linkCount} link${linkCount !== 1 ? 's' : ''}.`,
      'Delete User',
      'Delete',
      'red'
    );
    if (confirmed) {
      event.target.submit();
    }
    return false;
  }

  async function handleDeleteLink(event) {
    event.preventDefault();
    const confirmed = await showConfirmModal(
      'Are you sure you want to delete this link?',
      'Delete Link',
      'Delete',
      'red'
    );
    if (confirmed) {
      event.target.submit();
    }
    return false;
  }
</script>

<%- include('partials/footer') %>
